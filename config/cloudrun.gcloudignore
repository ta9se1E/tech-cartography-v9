# Cloud Run source upload — exclude secrets and bulk local artifacts.
# Canonical copy for Cloud Build workspace (gcloud never uploads .gcloudignore itself).
.git/
.gitignore
.venv/
**/__pycache__/
*.pyc
.env
.streamlit/secrets.toml
credentials/
data/runtime/
data/cache/
*.db
config/email_recipients.json
config/theme_validation_cases.json
inputs/manual/*
!inputs/manual/.gitkeep
.DS_Store

# Local generated outputs are not uploaded; use tracked demo_outputs bundle instead.
outputs/
