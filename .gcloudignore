# Cloud Run source upload — exclude secrets and bulk local artifacts.
.git/
.gitignore
.gcloudignore
.dockerignore
.venv/
**/__pycache__/
*.pyc
.env
.streamlit/secrets.toml
credentials/
data/runtime/
data/cache/
*.db
config/email_recipients.json
config/theme_validation_cases.json
inputs/manual/*
!inputs/manual/.gitkeep
.DS_Store

# Exclude most generated outputs; include US demo bundle only.
outputs/**
!outputs/evidence_map_synthesis/
!outputs/evidence_map_synthesis/US-12565719-B2/
