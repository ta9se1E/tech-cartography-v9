# Cloud Run demo defaults — copy to .env for local testing only.
# Do not commit .env. Do not set PORT here; Cloud Run injects PORT at runtime.

SHOW_DEVELOPER_MODE=false
APP_DEFAULT_MODE=demo
DEMO_OUTPUTS_ROOT=demo_outputs
DISABLE_EXTERNAL_API=true
DISABLE_EMAIL_SEND=true
DISABLE_SCHEDULER=true
STREAMLIT_SERVER_HEADLESS=true
