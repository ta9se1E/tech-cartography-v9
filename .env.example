# Cloud Run demo defaults — copy to .env for local testing only.
# Do not commit .env. Do not set PORT here; Cloud Run injects PORT at runtime.

SHOW_DEVELOPER_MODE=false
APP_DEFAULT_MODE=demo
DEMO_OUTPUTS_ROOT=demo_outputs
DISABLE_EXTERNAL_API=true
DISABLE_EMAIL_SEND=true
DISABLE_SCHEDULER=true
STREAMLIT_SERVER_HEADLESS=true

# Demo Cloud Run (no password gate):
REQUIRE_LOGIN=false

# Live / workplace beta (simple env login — preferred on Cloud Run live):
# REQUIRE_LOGIN=true
# TECH_CARTOGRAPHY_LOGIN_USERNAME=admin
# TECH_CARTOGRAPHY_LOGIN_PASSWORD=<set-in-cloud-run-env-or-secret>

# Fallback when TECH_CARTOGRAPHY_LOGIN_PASSWORD is not set:
# TECH_CARTOGRAPHY_USERS_JSON='[{"username":"admin","password_hash":"<bcrypt_hash>","role":"admin","display_name":"Admin"}]'

# API keys — Cloud Run live uses Secret Manager (--set-secrets). Do not commit real keys.
# Local .env may use placeholders only; values are never shown in UI or logs.
OPENAI_API_KEY=<secret-manager-only>
GOOGLE_API_KEY=<secret-manager-only>
GEMINI_API_KEY=<secret-manager-only>
TAVILY_API_KEY=<secret-manager-only>

# Live artifact persistence (Phase 25H) — Cloud Run live only; mount Cloud Storage bucket here.
# LIVE_OUTPUTS_ROOT=/mnt/live_artifacts/outputs

# Live email send (Phase 25G) — self_only test; SMTP_PASSWORD via Secret Manager on Cloud Run live.
# DISABLE_EMAIL_SEND=true
# EMAIL_SEND_MODE=self_only
# EMAIL_SENDER=<your-email@example.com>
# EMAIL_RECIPIENT_ALLOWLIST=<your-email@example.com>
# SMTP host/port/user — Cloud Run live uses env + Secret Manager for SMTP_PASSWORD.
# smtp port: 465 (SSL) or 587 (STARTTLS)
# SMTP_HOST=smtp.example.com
# smtp port env name: SMTP_PORT
# SMTP_USERNAME=<your-email@example.com>
# SMTP_PASSWORD=<secret-manager-only>
