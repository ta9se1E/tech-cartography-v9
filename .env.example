# Cloud Run demo defaults — copy to .env for local testing only.
# Do not commit .env. Do not set PORT here; Cloud Run injects PORT at runtime.

SHOW_DEVELOPER_MODE=false
APP_DEFAULT_MODE=demo
DEMO_OUTPUTS_ROOT=demo_outputs
DISABLE_EXTERNAL_API=true
DISABLE_EMAIL_SEND=true
DISABLE_SCHEDULER=true
STREAMLIT_SERVER_HEADLESS=true

# Demo Cloud Run (no password gate):
REQUIRE_LOGIN=false

# Live / workplace beta (simple env login — preferred on Cloud Run live):
# REQUIRE_LOGIN=true
# TECH_CARTOGRAPHY_LOGIN_USERNAME=admin
# TECH_CARTOGRAPHY_LOGIN_PASSWORD=<set-in-cloud-run-env-or-secret>

# Fallback when TECH_CARTOGRAPHY_LOGIN_PASSWORD is not set:
# TECH_CARTOGRAPHY_USERS_JSON='[{"username":"admin","password_hash":"<bcrypt_hash>","role":"admin","display_name":"Admin"}]'
